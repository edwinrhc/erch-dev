---
import { experiencesEn } from "../../data/portfolio-en";
---

<section id="experience" class="scroll-mt-24 px-6 md:px-12 max-w-5xl mx-auto text-slate-300 space-y-12">
    <h2 class="text-3xl font-bold text-blue-400 tracking-wide">Experience</h2>

    {experiencesEn.map((experience) => (
        <a href={experience.url} target="_blank" rel="noopener noreferrer" class="group block transition-all duration-300">
            <div class="p-1 rounded-xl transition-all duration-300 group-hover:bg-slate-800/30 group-hover:border group-hover:border-slate-700 group-hover:shadow-xl group-hover:scale-[1.01]">
                <div class="p-4">
                    <p class="text-sm uppercase tracking-widest text-slate-400 font-mono mb-2">
                        {experience.period}
                    </p>

                    <h3 class="text-lg md:text-xl font-bold text-white group-hover:text-blue-400 transition">
                        {experience.role} · {experience.company}
                    </h3>

                    <p class="text-sm text-slate-400 mt-1">
                        {experience.organization}
                    </p>

                    {experience.description.map((paragraph) => (
                        <p class="text-sm text-slate-300 mt-3 leading-relaxed">
                            {paragraph}
                        </p>
                    ))}

                    <div class="mt-4 flex flex-wrap gap-2 text-xs font-mono opacity-80">
                        {experience.tags.map((tag) => (
                            <span class="bg-blue-900/30 text-blue-300 px-2 py-1 rounded">{tag}</span>
                        ))}
                    </div>
                </div>
            </div>
        </a>
    ))}
</section>
