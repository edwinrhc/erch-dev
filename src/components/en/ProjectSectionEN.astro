---
import { colorClasses } from "../../data/portfolio";
import { projectsEn } from "../../data/portfolio-en";

const featuredProjects = projectsEn.filter((project) => project.featured);
---

<section id="projects" class="scroll-mt-24 text-slate-300 space-y-12">
    <h2 class="text-3xl font-bold text-blue-400 tracking-wide">Projects</h2>

    {featuredProjects.map((project) => {
        const colors = colorClasses[project.color as keyof typeof colorClasses];

        return (
            <a href={project.url} target="_blank" rel="noopener noreferrer" class="group block transition-all duration-300">
                <div class={`p-1 rounded-xl transition-all duration-300 group-hover:bg-slate-800/30 group-hover:border ${colors.border} group-hover:shadow-xl group-hover:scale-[1.01]`}>
                    <div class="p-4">
                        <p class="text-xs uppercase tracking-widest text-slate-500 font-mono mb-2">{project.subtitle}</p>
                        <h3 class={`text-lg md:text-xl font-bold text-white ${colors.title} transition`}>
                            <i class={`${project.icon} mr-2 text-sm`}></i>
                            {project.title}
                        </h3>
                        <p class="text-sm text-slate-300 mt-3 leading-relaxed">{project.description}</p>
                        <div class="mt-4 flex flex-wrap gap-2 text-xs font-mono">
                            {project.tags.map((tag) => (
                                <span class={`${colors.pill} px-2 py-1 rounded`}>{tag}</span>
                            ))}
                        </div>
                    </div>
                </div>
            </a>
        );
    })}

    <div class="text-center pt-2">
        <a
                href="/en/proyectos/"
                class="inline-flex items-center gap-3 px-4 py-2 rounded-lg
           bg-slate-800/40 border border-slate-700 text-blue-400
           font-mono text-sm hover:bg-slate-700/40 hover:text-white
           hover:border-blue-500 transition-all duration-300
           shadow-md hover:shadow-blue-500/20"
        >
            <i class="fa-solid fa-terminal text-sm"></i>
            View more projects
            <span class="text-xs opacity-70">›</span>
        </a>
    </div>
</section>
