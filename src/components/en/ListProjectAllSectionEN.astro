---
import { colorClasses } from "../../data/portfolio";
import { projectsEn } from "../../data/portfolio-en";
---

<section class="pt-32 px-6 md:px-12 max-w-5xl mx-auto text-slate-300">
    <h1 class="text-3xl md:text-4xl font-bold text-white mb-8">All my projects</h1>
    <p class="text-slate-400 max-w-2xl mb-12">
        A collection of personal and professional projects, including backend systems,
        web applications, service integrations, legacy migrations and microservices solutions.
    </p>

    <ul class="space-y-8">
        {projectsEn.map((project) => {
            const colors = colorClasses[project.color as keyof typeof colorClasses];

            return (
                <li class="group transition-all duration-300 hover:bg-slate-800/30 p-4 rounded-lg">
                    <p class="text-xs uppercase tracking-widest text-slate-500 font-mono mb-2">{project.subtitle}</p>
                    <h3 class={`text-lg md:text-xl font-semibold text-white ${colors.title}`}>
                        <i class={`${project.icon} mr-2 text-sm`}></i>
                        {project.title}
                    </h3>
                    <p class="text-sm text-slate-300 mt-2 leading-relaxed">
                        {project.description}
                    </p>
                    <div class="mt-3 flex flex-wrap gap-2 text-xs font-mono">
                        {project.tags.map((tag) => (
                            <span class={`${colors.pill} px-2 py-0.5 rounded`}>{tag}</span>
                        ))}
                    </div>
                    <a href={project.url} target="_blank" rel="noopener noreferrer" class="text-sm text-blue-400 hover:underline mt-3 inline-block">
                        <i class="fa-brands fa-github"></i> View on GitHub
                    </a>
                </li>
            );
        })}
    </ul>

    <div class="mt-20 text-center">
        <a href="/en/" class="inline-block font-mono text-sm px-6 py-3 border border-blue-500 text-blue-400 rounded hover:bg-blue-500/10 transition">
            <span class="text-green-400">edwin@dev</span>:<span class="text-blue-400">~</span>$ Back home
        </a>
    </div>
</section>

<a href="#" class="fixed bottom-6 right-6 bg-blue-600 text-white p-3 rounded-full shadow-lg hover:bg-blue-700 transition" title="Back to top">
    <i class="fa-solid fa-arrow-up"></i>
</a>
