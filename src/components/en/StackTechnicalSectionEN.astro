---
import { stackCategoriesEn } from "../../data/portfolio-en";
---

<section id="stack" class="scroll-mt-24 px-6 md:px-12 max-w-5xl mx-auto">
    <h2 class="text-3xl font-bold text-blue-400 tracking-wide mb-10">
        Technical Stack
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">
        {stackCategoriesEn.map((category) => (
            <div class="card-hover">
                <div class="stack-card-inner">
                    <div class="stack-header">
                        <i class={`${category.icon} stack-icon`}></i>
                        <h3 class="stack-title">{category.title}</h3>
                    </div>
                    <div class="stack-tags">
                        {category.items.map((item) => (
                            <span class="stack-pill">{item}</span>
                        ))}
                    </div>
                </div>
            </div>
        ))}
    </div>
</section>
