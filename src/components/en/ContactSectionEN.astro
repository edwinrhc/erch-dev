<section id="contact" class="scroll-mt-24 text-slate-300 space-y-12">
    <div class="space-y-5 text-base leading-relaxed">
        <h2 class="text-3xl font-bold mb-8 text-blue-400 tracking-wide">Contact</h2>

        <p>If you want to collaborate, hire my services or discuss a backend solution, send me a message.</p>

        <form
                id="contactForm"
                action="https://formspree.io/f/xrbrjwpw"
                method="POST"
                class="space-y-6 bg-slate-800/30 p-6 rounded-xl border border-slate-700"
        >
            <div>
                <label class="block mb-2 text-sm font-semibold" for="name">Name</label>
                <input id="name" type="text" name="name" autocomplete="name" required class="w-full px-4 py-2 rounded-lg bg-slate-900 border border-slate-700 text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
                <label class="block mb-2 text-sm font-semibold" for="email">Email</label>
                <input id="email" type="email" name="email" autocomplete="email" required class="w-full px-4 py-2 rounded-lg bg-slate-900 border border-slate-700 text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </div>

            <div>
                <label class="block mb-2 text-sm font-semibold" for="message">Message</label>
                <textarea id="message" name="message" rows="4" required class="w-full px-4 py-2 rounded-lg bg-slate-900 border border-slate-700 text-slate-200 focus:outline-none focus:ring-2 focus:ring-blue-500"></textarea>
            </div>

            <button type="submit" class="w-full py-3 rounded-lg bg-blue-600 hover:bg-blue-700 transition font-semibold">
                Send message
            </button>
        </form>

        <div id="toast" role="status" aria-live="polite" class="hidden fixed bottom-6 right-6 bg-slate-800 border border-slate-700 text-slate-200 px-6 py-4 rounded-xl shadow-lg"></div>
    </div>
</section>

<script>
    const form = document.getElementById("contactForm");
    const toast = document.getElementById("toast");

    form?.addEventListener("submit", async (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const response = await fetch(form.action, {
            method: form.method,
            body: data,
            headers: { Accept: "application/json" },
        });

        if (response.ok) {
            showToast("Message sent successfully. Thanks for reaching out!");
            form.reset();
            return;
        }

        showToast("There was an error sending the message. Please try again.");
    });

    function showToast(message) {
        if (!toast) return;

        toast.textContent = message;
        toast.classList.remove("hidden", "opacity-0");
        toast.classList.add("opacity-100");

        setTimeout(() => {
            toast.classList.add("opacity-0");
            setTimeout(() => toast.classList.add("hidden"), 500);
        }, 3000);
    }
</script>
