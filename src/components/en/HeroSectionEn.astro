---
import AboutSection from "./AboutSectionEN.astro";
import ContactSection from "./ContactSectionEN.astro";
import CredentialsSection from "../CredentialsSection.astro";
import ExperienceSection from "./ExperienceSectionEN.astro";
import PerfilSection from "../PerfilSection.astro";
import ProjectSection from "./ProjectSectionEN.astro";
import StackTechnicalSection from "./StackTechnicalSectionEN.astro";
---

<section class="max-w-7xl mx-auto px-6 md:px-12 pt-24 flex flex-col md:flex-row gap-14 md:gap-20">
    <div class="w-full md:w-[26rem] lg:w-[28rem] md:shrink-0">
        <aside class="md:sticky md:top-24 md:self-start">
            <PerfilSection lang="en" />
        </aside>
    </div>

    <main class="flex-1 space-y-24">
        <AboutSection />
        <StackTechnicalSection />
        <ExperienceSection />
        <ProjectSection />
        <CredentialsSection lang="en" />
        <ContactSection />
    </main>
</section>
