---
import AboutSection from "./AboutSectionEN.astro";
import ExperienceSection from "./ExperienceSectionEN.astro";
import ProjectSection from "./ProjectSectionEN.astro";
import StackTechnicalSection from "./StackTechnicalSectionEN.astro";
import ContactSection from "./ContactSectionEN.astro";
---

<section class="max-w-7xl mx-auto px-6 md:px-12 pt-24 flex flex-col md:flex-row gap-20">
    <div class="hidden md:block md:w-[26rem] lg:w-[28rem]">
        <aside class="sticky top-24 self-start whitespace-nowrap">
            <h1 class="text-4xl font-bold text-white">Edwin Huamanttupa</h1>
            <p class="mt-1 text-blue-300">
                <span id="typing-role"></span>
            </p>

            <ul class="mt-5 space-y-4 text-gray-400 font-mono text-sm">
                <li>
                    <a href="#about" class="group flex items-center gap-2 transition-all duration-300 ease-in-out">
                        <span class="block h-px w-6 bg-gray-600 transition-all duration-300 ease-in-out group-hover:w-12 group-hover:bg-blue-400"></span>
                        <span class="transform transition-transform duration-300 ease-in-out group-hover:translate-x-1 group-hover:text-blue-400">ABOUT</span>
                    </a>
                </li>
                <li>
                    <a href="#stack" class="group flex items-center gap-2 transition-all duration-300 ease-in-out">
                        <span class="block h-px w-6 bg-gray-600 transition-all duration-300 ease-in-out group-hover:w-12 group-hover:bg-blue-400"></span>
                        <span class="transform transition-transform duration-300 ease-in-out group-hover:translate-x-1 group-hover:text-blue-400">STACK</span>
                    </a>
                </li>
                <li>
                    <a href="#experience" class="group flex items-center gap-2 transition-all duration-300 ease-in-out">
                        <span class="block h-px w-6 bg-gray-600 transition-all duration-300 ease-in-out group-hover:w-12 group-hover:bg-blue-400"></span>
                        <span class="transform transition-transform duration-300 ease-in-out group-hover:translate-x-1 group-hover:text-blue-400">EXPERIENCE</span>
                    </a>
                </li>
                <li>
                    <a href="#projects" class="group flex items-center gap-2 transition-all duration-300 ease-in-out">
                        <span class="block h-px w-6 bg-gray-600 transition-all duration-300 ease-in-out group-hover:w-12 group-hover:bg-blue-400"></span>
                        <span class="transform transition-transform duration-300 ease-in-out group-hover:translate-x-1 group-hover:text-blue-400">PROJECTS</span>
                    </a>
                </li>
                <li>
                    <a href="#contact" class="group flex items-center gap-2 transition-all duration-300 ease-in-out">
                        <span class="block h-px w-6 bg-gray-600 transition-all duration-300 ease-in-out group-hover:w-12 group-hover:bg-blue-400"></span>
                        <span class="transform transition-transform duration-300 ease-in-out group-hover:translate-x-1 group-hover:text-blue-400">CONTACT</span>
                    </a>
                </li>
            </ul>

            <div class="mt-5 flex space-x-4 text-gray-400">
                <a href="https://github.com/edwinrhc" class="hover:text-blue-400" target="_blank" rel="noopener noreferrer" aria-label="GitHub">
                    <i class="fa-brands fa-github"></i>
                </a>
                <a href="https://linkedin.com/in/edwinrhc" class="hover:text-blue-400" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                    <i class="fa-brands fa-linkedin"></i>
                </a>
                <a href="mailto:ehuamanttupa@erhc-dev.com" class="hover:text-blue-400" aria-label="Email">
                    <i class="fa-solid fa-envelope"></i>
                </a>
            </div>
        </aside>
    </div>

    <main class="flex-1 space-y-24">
        <AboutSection />
        <StackTechnicalSection />
        <ExperienceSection />
        <ProjectSection />
        <ContactSection />
    </main>
</section>

<script type="module" src="/src/scripts/typing-loader.js"></script>
