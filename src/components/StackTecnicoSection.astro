<section
        id="stack"
        class="scroll-mt-24 px-6 md:px-12 max-w-5xl mx-auto"
>
    <h2 class="text-3xl font-bold text-blue-400 tracking-wide mb-10">
        Stack Técnico
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-6">

        <!-- Lenguajes -->
        <div class="card-hover">
            <div class="stack-card-inner">
                <div class="stack-header">
                    <i class="fa-solid fa-code stack-icon"></i>
                    <h3 class="stack-title">Lenguajes</h3>
                </div>
                <div class="stack-tags">
                    <span class="stack-pill">Java</span>
                    <span class="stack-pill">TypeScript</span>
                    <span class="stack-pill">JavaScript</span>
                    <span class="stack-pill">C#</span>
                    <span class="stack-pill">Python</span>
                    <span class="stack-pill">SQL</span>
                </div>
            </div>
        </div>

        <!-- Backend -->
        <div class="card-hover">
            <div class="stack-card-inner">
                <div class="stack-header">
                    <i class="fa-solid fa-server stack-icon"></i>
                    <h3 class="stack-title">Backend & Frameworks</h3>
                </div>
                <div class="stack-tags">
                    <span class="stack-pill">Spring Boot</span>
                    <span class="stack-pill">Spring Security</span>
                    <span class="stack-pill">Spring Cloud</span>
                    <span class="stack-pill">Node.js</span>
                    <span class="stack-pill">NestJS</span>
                    <span class="stack-pill">ASP.NET Core</span>
                </div>
            </div>
        </div>

        <!-- Arquitectura -->
        <div class="card-hover">
            <div class="stack-card-inner">
                <div class="stack-header">
                    <i class="fa-solid fa-layer-group stack-icon"></i>
                    <h3 class="stack-title">Arquitectura & Diseño</h3>
                </div>
                <div class="stack-tags">
                    <span class="stack-pill">APIs REST</span>
                    <span class="stack-pill">Microservicios</span>
                    <span class="stack-pill">Arquitectura por capas</span>
                    <span class="stack-pill">JWT</span>
                    <span class="stack-pill">Control de roles</span>
                </div>
            </div>
        </div>

        <!-- Bases de Datos -->
        <div class="card-hover">
            <div class="stack-card-inner">
                <div class="stack-header">
                    <i class="fa-solid fa-database stack-icon"></i>
                    <h3 class="stack-title">Bases de Datos</h3>
                </div>
                <div class="stack-tags">
                    <span class="stack-pill">Oracle</span>
                    <span class="stack-pill">MySQL</span>
                    <span class="stack-pill">SQL Server</span>
                    <span class="stack-pill">JPA / Hibernate</span>
                    <span class="stack-pill">EF Core</span>
                </div>
            </div>
        </div>

        <!-- DevOps -->
        <div class="card-hover">
            <div class="stack-card-inner">
                <div class="stack-header">
                    <i class="fa-solid fa-cloud stack-icon"></i>
                    <h3 class="stack-title">DevOps & Infra</h3>
                </div>
                <div class="stack-tags">
                    <span class="stack-pill">Docker</span>
                    <span class="stack-pill">Docker Compose</span>
                    <span class="stack-pill">CI/CD</span>
                    <span class="stack-pill">JBoss</span>
                    <span class="stack-pill">Linux</span>
                </div>
            </div>
        </div>

        <!-- Testing -->
        <div class="card-hover">
            <div class="stack-card-inner">
                <div class="stack-header">
                    <i class="fa-solid fa-screwdriver-wrench stack-icon"></i>
                    <h3 class="stack-title">Testing & Herramientas</h3>
                </div>
                <div class="stack-tags">
                    <span class="stack-pill">JUnit</span>
                    <span class="stack-pill">Mockito</span>
                    <span class="stack-pill">Swagger</span>
                    <span class="stack-pill">Postman</span>
                    <span class="stack-pill">Git</span>
                    <span class="stack-pill">GitHub</span>
                </div>
            </div>
        </div>

    </div>
</section>
