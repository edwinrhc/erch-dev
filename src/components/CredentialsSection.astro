---
const { lang = "es" } = Astro.props;
const isEnglish = lang === "en";

const education = isEnglish
    ? [
        { title: "BSc in Systems and Computer Engineering", institution: "Universidad Tecnológica del Perú (UTP)" },
        { title: "Technical Degree in Computing and Information Technology", institution: "IDAT"},
    ]
    : [
        { title: "Bachiller en Ingeniería de Sistemas e Informática", institution: "Universidad Tecnológica del Perú (UTP)" },
        { title: "Técnico en Computación e Informática", institution: "IDAT" },
    ];

const certifications = isEnglish
    ? [
        "Cybersecurity and Cyberdefense · 70 hours · 2025",
        "Object-Oriented Java · Oracle Next Education / Alura · 110 hours",
        "Spring Boot 2 and Spring MVC · 42.5 hours",
        "Microsoft Power Platform Fundamentals",
    ]
    : [
        "Ciberseguridad y Ciberdefensa · 70 horas · 2025",
        "Java Orientado a Objetos · Oracle Next Education / Alura · 110 horas",
        "Spring Boot 2 y Spring MVC · 42.5 horas",
        "Microsoft Power Platform Fundamentals",
    ];
---

<section id={isEnglish ? "credentials" : "formacion"} class="scroll-mt-24 space-y-10">
    <h2 class="text-3xl font-bold text-blue-400 tracking-wide">
        {isEnglish ? "Education & Credentials" : "Formación y certificaciones"}
    </h2>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <article class="rounded-xl border border-slate-700 bg-slate-800/30 p-6">
            <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-white">
                <i class="fa-solid fa-graduation-cap text-blue-400" aria-hidden="true"></i>
                {isEnglish ? "Education" : "Educación"}
            </h3>
            <div class="space-y-5">
                {education.map((item) => (
                    <div>
                        <p class="font-semibold text-slate-200">{item.title}</p>
                        <p class="mt-1 text-sm leading-relaxed text-slate-400">{item.institution} · {item.year}</p>
                    </div>
                ))}
            </div>
        </article>

        <article class="rounded-xl border border-slate-700 bg-slate-800/30 p-6">
            <h3 class="mb-5 flex items-center gap-3 text-lg font-bold text-white">
                <i class="fa-solid fa-certificate text-blue-400" aria-hidden="true"></i>
                {isEnglish ? "Selected credentials" : "Credenciales destacadas"}
            </h3>
            <ul class="space-y-4 text-sm leading-relaxed text-slate-300">
                {certifications.map((certification) => (
                    <li class="flex gap-3">
                        <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-400"></span>
                        <span>{certification}</span>
                    </li>
                ))}
            </ul>
        </article>
    </div>
</section>
