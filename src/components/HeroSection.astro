<section
        class="max-w-7xl mx-auto
         px-6 md:px-12 pt-24
         flex flex-col md:flex-row gap-20"
>

    <!-- SIDEBAR -->
    <div class="hidden md:block md:w-[26rem] lg:w-[28rem]">
        <aside class="sticky top-24 self-start">
            <PerfilSection />
        </aside>
    </div>

    <!-- CONTENIDO -->
    <main class="flex-1 space-y-24">
        <AboutSection />
        <StackTecnicoSection />
        <ExperienceSection />
        <ProjectSection />
        <ContactSection />
    </main>

</section>


