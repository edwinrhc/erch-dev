---
import "../styles/global.css";
import Footer from "../components/FooterSection.astro";
import "@fortawesome/fontawesome-free/css/all.min.css";

const {
    title = "Edwin Huamanttupa | Backend Developer",
    description = "Portafolio de Edwin Huamanttupa, desarrollador backend especializado en Java, Spring Boot, microservicios y sistemas empresariales.",
    lang = "es",
} = Astro.props;

const isEnglish = lang === "en";
const currentPath = Astro.url.pathname;
const languageHref = isEnglish
    ? currentPath.replace(/^\/en/, "") || "/"
    : currentPath === "/proyectos" || currentPath === "/proyectos/"
        ? "/en/proyectos/"
        : "/en/";
const languageLabel = isEnglish ? "ES" : "EN";
const languageTitle = isEnglish ? "Cambiar a español" : "Switch to English";
---

<html lang={lang} class="bg-gray-950 text-white scroll-smooth">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="author" content="Edwin Huamanttupa" />
    <meta name="robots" content="index, follow" />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content="https://www.erhc-dev.com" />
    <meta property="og:type" content="website" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/images/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>

    <script is:inline>
        const storedTheme = localStorage.getItem("theme");
        const prefersLight = window.matchMedia("(prefers-color-scheme: light)").matches;
        const theme = storedTheme ?? (prefersLight ? "light" : "dark");

        document.documentElement.classList.toggle("theme-light", theme === "light");
        document.documentElement.dataset.theme = theme;
    </script>
</head>

<body class="min-h-screen bg-gradient-to-b from-gray-900 via-gray-950 to-black font-mono text-white">
    <div class="fixed top-4 right-4 z-50 flex items-center gap-2">
        <button
                id="themeToggle"
                type="button"
                class="control-button"
                aria-label="Cambiar tema"
                title="Cambiar tema"
        >
            <i id="themeIcon" class="fa-solid fa-moon"></i>
        </button>

        <a
                href={languageHref}
                class="control-button text-xs font-bold"
                aria-label={languageTitle}
                title={languageTitle}
        >
            {languageLabel}
        </a>
    </div>

    <slot />
    <Footer />
    <script type="module" src="/src/scripts/scroll-title.js"></script>
    <script type="module" src="/src/scripts/theme-toggle.js"></script>
</body>
</html>
